{
  "manifest_version": 3,
  "minimum_chrome_version": "150",
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "version": "2.71.1",
  "default_locale": "en",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.iflix.com/*",
    "https://www.iq.com/*",
    "https://www.viki.com/*",
    "https://www.youku.tv/*",
    "https://wetv.vip/*",
    "https://clients5.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "world": "MAIN",
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.iflix.com/*",
        "https://www.iq.com/*",
        "https://www.viki.com/*",
        "https://www.youku.tv/*",
        "https://wetv.vip/*"
      ],
      "js": [
        "main.js"
      ]
    },
    {
      "world": "ISOLATED",
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.iflix.com/*",
        "https://www.iq.com/*",
        "https://www.viki.com/*",
        "https://www.youku.tv/*",
        "https://wetv.vip/*"
      ],
      "js": [
        "pinyin-pro.js",
        "dsx-pinyin.js",
        "isolated.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "version_name": "2.71.1-private"
}
